model ContactWhyChooseUsContent {
  id             String   @id @default(uuid())
  locale         String   @unique
  overline       String
  chartLabel     String
  chartHeading   String
  chartParagraph String
  chartBarValues Json
  rightHeading   String
  rightParagraph String
  bandText       String
  updatedAt      DateTime @updatedAt
}

model ContactFeatureCard {
  id          String   @id @default(uuid())
  locale      String
  order       Int
  icon        String
  title       String
  description String
  updatedAt   DateTime @updatedAt
}

model ContactInfo {
  id           String   @id @default(uuid())
  locale       String   @unique
  address      String
  phone        String
  email        String
  workingHours String
  mapLatitude  Float?
  mapLongitude Float?
  updatedAt    DateTime @updatedAt
}

model ContactSubmission {
  id         String   @id @default(uuid())
  fullName   String
  phone      String?
  email      String
  message    String
  sourcePage String
  locale     String
  status     String   @default("new")
  createdAt  DateTime @default(now())
}

model TranslationEntry {
  id        String   @id @default(uuid())
  namespace String
  key       String
  locale    String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([namespace, key, locale])
}

model AdminUser {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String
  name               String
  role               String    @default("admin")
  isActive           Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  mustChangePassword Boolean   @default(true)
}

// ---------------------------------------------------------------------------
// Page builder — admin-created pages composed of ordered content blocks.
// Purely additive: no relation to the content models above.
// ---------------------------------------------------------------------------

model Page {
  id           String            @id @default(uuid())
  slug         String            @unique
  status       String            @default("draft") // draft | published
  showInNav    Boolean           @default(false)
  navOrder     Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  translations PageTranslation[]
  blocks       PageBlock[]
}

model PageTranslation {
  id             String   @id @default(uuid())
  pageId         String
  locale         String
  title          String
  navLabel       String?
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?
  updatedAt      DateTime @updatedAt
  page           Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
}

model PageBlock {
  id        String   @id @default(uuid())
  pageId    String
  locale    String
  order     Int
  type      String
  props     Json
  isVisible Boolean  @default(true)
  updatedAt DateTime @updatedAt
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, locale])
}

// ---------------------------------------------------------------------------
// Form builder — admin-defined forms (fields per language) and their answers.
// Independent from ContactSubmission, which keeps serving the contact page.
// ---------------------------------------------------------------------------

model Form {
  id          String           @id @default(uuid())
  name        String
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  locales     FormLocale[]
  submissions FormSubmission[]
}

model FormLocale {
  id           String   @id @default(uuid())
  formId       String
  locale       String
  fields       Json
  submitLabel  String   @default("")
  successTitle String   @default("")
  successText  String   @default("")
  updatedAt    DateTime @updatedAt
  form         Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, locale])
}

model FormSubmission {
  id         String   @id @default(uuid())
  formId     String
  locale     String
  sourcePage String   @default("")
  data       Json
  status     String   @default("new")
  createdAt  DateTime @default(now())
  // Restrict: a form with answers cannot be deleted by accident (deactivate it instead)
  form       Form     @relation(fields: [formId], references: [id], onDelete: Restrict)

  @@index([formId, createdAt])
}

// ---------------------------------------------------------------------------
// Booking — Calendly-style meeting reservations.
// One shared calendar (BookingSettings), several meeting types, time off, and bookings.
// ---------------------------------------------------------------------------

model BookingSettings {
  id              String   @id @default("default")
  timezone        String   @default("Asia/Baku")
  weeklyHours     Json
  slotStepMinutes Int      @default(30)
  bufferMinutes   Int      @default(0)
  minNoticeHours  Int      @default(12)
  maxDaysAhead    Int      @default(60)
  updatedAt       DateTime @updatedAt
}

model BookingType {
  id              String              @id @default(uuid())
  name            String
  durationMinutes Int
  isActive        Boolean             @default(true)
  order           Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  locales         BookingTypeLocale[]
  bookings        Booking[]
}

model BookingTypeLocale {
  id           String      @id @default(uuid())
  typeId       String
  locale       String
  title        String
  description  String      @default("")
  locationNote String      @default("")
  successText  String      @default("")
  // Booking form fields built in the admin (same shape as the form builder). null = classic fixed form (phone + note).
  fields       Json?
  updatedAt    DateTime    @updatedAt
  type         BookingType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  @@unique([typeId, locale])
}

model BookingTimeOff {
  id        String   @id @default(uuid())
  startsAt  DateTime
  endsAt    DateTime
  reason    String   @default("")
  createdAt DateTime @default(now())
}

model Booking {
  id              String      @id @default(uuid())
  typeId          String
  startsAt        DateTime
  endsAt          DateTime
  status          String      @default("confirmed")
  isSeen          Boolean     @default(false)
  name            String
  email           String
  phone           String?
  message         String?
  locale          String
  visitorTimezone String      @default("")
  adminNote       String?
  // Answers to the extra form fields (label and type copied at booking time)
  answers         Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  // Restrict: a meeting type with bookings cannot be deleted by accident (deactivate it instead)
  type            BookingType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  @@index([startsAt])
  @@index([typeId])
}
