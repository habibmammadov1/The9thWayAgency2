model BlogCategory {
  id        String     @id @default(uuid())
  locale    String
  name      String
  slug      String
  order     Int
  updatedAt DateTime   @updatedAt
  posts     BlogPost[]

  @@unique([locale, slug])
}

model BlogPost {
  id               String        @id @default(uuid())
  locale           String
  slug             String
  title            String
  excerpt          String
  content          Json
  featuredImageUrl String?
  categoryId       String?
  authorName       String
  authorAvatarUrl  String?
  authorBio        String?
  publishedAt      DateTime      @default(now())
  isPublished      Boolean       @default(true)
  updatedAt        DateTime      @updatedAt
  category         BlogCategory? @relation(fields: [categoryId], references: [id])

  @@unique([locale, slug])
}

