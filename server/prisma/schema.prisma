}

model TeamIntroContent {
  id        String   @id @default(uuid())
  locale    String   @unique
  pillLabel String
  heading   String
  paragraph String
  updatedAt DateTime @updatedAt
}

model TeamTeaserSettings {
  id           String   @id @default(uuid())
  locale       String
  page         String
  heading      String
  viewAllLabel String
  displayCount Int      @default(4)
  updatedAt    DateTime @updatedAt

  @@unique([locale, page])
