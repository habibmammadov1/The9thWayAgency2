# .env.example
# Vercel Deployment Configuration

# -----------------------------------------------------------------------------
# Placeholder API URLs (Update these once the backend is ready)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_FORM_SUBMISSION_ENDPOINT=http://localhost:4000/api/contact

# -----------------------------------------------------------------------------
# Database Configuration (local dev)
# -----------------------------------------------------------------------------
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=the9thway

# Full connection string — used by the API and Prisma
DATABASE_URL=postgresql://admin:password123@localhost:5432/the9thway?schema=public

# -----------------------------------------------------------------------------
# API Server
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# JWT secret for admin session cookies — generate a strong random value for production
# Example: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# CORS — URL of the frontend that the API should allow requests from
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Azure Blob Storage (production only — leave empty for local dev)
# The API falls back to local disk storage when this is not set.
# -----------------------------------------------------------------------------
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_STORAGE_CONTAINER=uploads

# -----------------------------------------------------------------------------
# External Services
# -----------------------------------------------------------------------------
# Google Maps API Key (For the Contact page embed, if applicable)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Analytics / Tracking (Optional)
# NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX

